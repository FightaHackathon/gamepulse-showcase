*.sqlite3-shm
*.sqlite3-wal
!data/prototype/*.sqlite3
!data/prototype/*.sqlite3-shm
!data/prototype/*.sqlite3-wal
data/prototype/gamepulse-*.sqlite3
!data/prototype/gamepulse_prototype.sqlite3

