# GamePulse local desktop configuration
# Copy this file to .env. Never commit real secrets.
GAMEPULSE_PROCESSED_DATE=2026-08-01
GAMEPULSE_DATABASE_PATH=data/prototype/gamepulse_prototype.sqlite3

# Source-neutral defaults. These work without Twitch credentials.
GAME_SIGNAL_PROVIDER=auto
CREATOR_PROVIDER=auto
GAMEPULSE_SNAPSHOT_PATH=data/demo/gamepulse_snapshot.json
CREATOR_DIRECTORY_PATH=data/manual/creators.csv

# Optional Twitch enhancement provider.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_SNAPSHOT_PATH=data/manual/twitch_snapshot.json
TWITCH_DEMO_SNAPSHOT_PATH=data/demo/twitch_snapshot.json

# Optional Steam Web API key for player-profile personalization only.
# Prepared Steam/public game opportunity signals do not require this key.
STEAM_WEB_API_KEY=

# Optional public estimate providers use this local 24-hour cache.
GAMEPULSE_EXTERNAL_CACHE_PATH=data/cache/external-provider-cache.json

# Optional future documented Streams Charts integration seam.
STREAMSCHARTS_CLIENT_ID=
STREAMSCHARTS_TOKEN=

# Reserved for an optional Mistral integration; local review analysis works without it.
MISTRAL_API_KEY=
