# GamePulse Fusion Web server configuration
# Copy this file to .env for local server development only. Never commit real secrets.

# Durable web data store. Use a pooled Neon/Postgres URL in hosted environments.
DATABASE_URL=

# Protects scheduled refresh endpoints. Required before enabling cron in production.
CRON_SECRET=

# Optional server-side concept-generation enhancement. Developer Mode has a deterministic fallback without it.
MISTRAL_API_KEY=

# Runtime tuning
APP_ENV=development
PROVIDER_TIMEOUT_SECONDS=15
SNAPSHOT_STALE_HOURS=48

# Legacy local prototype inputs remain in gamepulse/config.py for old Streamlit scripts.
# Visitor Steam Web API keys are NOT configured here; the web app accepts them only in browser runtime memory per session.
