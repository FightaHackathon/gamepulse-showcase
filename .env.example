# GamePulse local prototype configuration
# Copy this file to .env. Never commit real secrets.
GAMEPULSE_PROCESSED_DATE=2026-08-01

# Twitch Developer Console: used only for the live provider.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Steam Web API key: keep Game Details public for profile personalization.
STEAM_WEB_API_KEY=

# Reserved for a future optional Mistral integration; local review analysis works without it.
MISTRAL_API_KEY=
